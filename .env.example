# Chave para o Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Alternativa suportada pela aplicação
GOOGLE_API_KEY=your_gemini_api_key_here

# Modelo principal e fallback da aplicação
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-2.0-flash

# Tempo máximo para a chamada à IA antes de responder 504
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY_SECONDS=1.0